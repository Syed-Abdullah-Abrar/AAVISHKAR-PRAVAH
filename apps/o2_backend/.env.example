# O2 Platform — Environment Variables
# Copy this to .env and fill in values

# ─── Telegram Bot (Required for Phase 3) ────────────────────────────────
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=8717671171:AAEmr0UNaBRuZvRoHeJ5SYMdd87N1-xFZYg

# ─── AI / LLM ──────────────────────────────────────────────────────────
# MiniMax API for SBAR generation
# Get from https://platform.minimaxi.com/
MINIMAX_API_KEY=

# ─── Database ────────────────────────────────────────────────────────
# SQLite for demo (Supabase for production)
DB_PATH=o2_platform.db

# ─── IVR / Voice ────────────────────────────────────────────────────
# IndicTrans2 Docker: docker run -d -p 8000:8000 --name indictrans aiforskill/indictrans2:latest
INDICTRANS_URL=http://localhost:8000

# ─── API Adapters (flip to true when live credentials arrive) ─────────
USE_LIVE_ABDM=false
USE_TWILIO=false
USE_BHASHINI=false

# ─── Supervisor Dashboard ──────────────────────────────────────────────
SUPERVISOR_DASHBOARD_PORT=8080
SUPERVISOR_PHC_ID=PHC001
PHC_SUPERVISOR_TELEGRAM_ID=

# ─── ML Model ────────────────────────────────────────────────────────
XGBOOST_MODEL_PATH=models/risk_model.json

# ─── Deployment ──────────────────────────────────────────────────────
ENV=development